    "program:demo": "node hiperia_program/scripts/demo.js",
    "test:contract": "node scripts/test-contract.js",
    "format": "prettier --write \"src/**/*.{js,jsx,css,json}\" \"scripts/**/*.js\" \"hiperia_program/{scripts,tests}/**/*.js\" \"dev/**/*.{jsx,html}\" *.js *.json *.md index.html",
    "test:ui": "node scripts/test-ui.js",
