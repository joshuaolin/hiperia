{
  "name": "hiperia",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node scripts/test.js",
    "preview": "vite preview",
    "program:prepare": "node scripts/prepare-program.js",
    "program:sync-idl": "node scripts/sync-idl.js",
    "program:initialize": "node hiperia_program/scripts/initialize.js",
    "program:configure-uat": "node hiperia_program/scripts/configure-uat.js",
